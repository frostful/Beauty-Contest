{
  "name": "median-beauty-contest",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm db:migrate:local && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "tsx --test tests/*.test.mjs",
    "test:live": "node tests/live-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "WRANGLER_LOG_PATH=.wrangler/migrate.log wrangler d1 migrations apply median-beauty-contest --local",
    "test:features": "node tests/game-features-live.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.4.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vinext": "1.4.0",
    "vite": "8.3.5",
    "wrangler": "4.155.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.19.0"
}
