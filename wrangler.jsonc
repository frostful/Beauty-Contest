{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "median",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "ratelimits": [
    {
      "name": "ROOM_CREATE_LIMITER",
      "namespace_id": "31219001",
      "simple": { "limit": 6, "period": 60 }
    },
    {
      "name": "ROOM_JOIN_LIMITER",
      "namespace_id": "31219002",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "GAME_API_LIMITER",
      "namespace_id": "31219003",
      "simple": { "limit": 240, "period": 60 }
    },
    {
      "name": "LIVE_CONNECT_LIMITER",
      "namespace_id": "31219004",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "ADMIN_API_LIMITER",
      "namespace_id": "31219005",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "median-beauty-contest",
      "database_id": "f4234041-b2ea-4459-b218-7023ede538b1",
      "migrations_dir": "drizzle"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM_EVENTS",
        "class_name": "RoomEvents"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomEvents"]
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  }
}
